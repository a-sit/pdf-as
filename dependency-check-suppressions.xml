<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- 
    This file contains suppressions for false positives in dependency vulnerability scanning.
    Add suppressions here for known false positives or accepted risks.
    
    Example suppression:
    <suppress>
        <notes><![CDATA[
        This vulnerability does not apply to our usage of the library.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.example/.*@.*$</packageUrl>
        <cve>CVE-2021-12345</cve>
    </suppress>
    -->
    
    <!-- Common false positives for PDF processing libraries -->
    <suppress>
        <notes><![CDATA[
        Suppress vulnerabilities in test dependencies that don't affect production
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/junit/junit@.*$</packageUrl>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>
</suppressions>